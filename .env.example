# --- Interactive Brokers (TWS / IB Gateway) ---------------------------------
# Start TWS or IB Gateway and enable: Configure > API > Settings >
#   "Enable ActiveX and Socket Clients". Add 127.0.0.1 to trusted IPs.
# Ports:  7497 = TWS paper | 7496 = TWS live | 4002 = Gateway paper | 4001 = Gateway live
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_CONNECT_TIMEOUT=8
# Leave empty to auto-detect the first managed account.
IBKR_ACCOUNT=
# Safety: true blocks all order placement. Set to false only when you intend to trade.
IBKR_READONLY=true
# Market data type: 1=live, 2=frozen, 3=delayed, 4=delayed-frozen
IBKR_MARKET_DATA_TYPE=3

# --- Platform server --------------------------------------------------------
OBB_IBKR_HOST=127.0.0.1
OBB_IBKR_PORT=6900

# --- OpenBB provider API keys (optional) ------------------------------------
# yfinance works with no key. Add keys to unlock other providers, e.g.:
# OPENBB_FMP_API_KEY=...
# OPENBB_INTRINIO_API_KEY=...
# OPENBB_TIINGO_TOKEN=...
