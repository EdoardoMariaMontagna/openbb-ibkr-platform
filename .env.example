# --- Interactive Brokers (TWS / IB Gateway) ---------------------------------
# Start TWS or IB Gateway and enable: Configure > API > Settings >
#   "Enable ActiveX and Socket Clients". Add 127.0.0.1 to trusted IPs.
# Ports:  7497 = TWS paper | 7496 = TWS live | 4002 = Gateway paper | 4001 = Gateway live
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_CONNECT_TIMEOUT=8
# Leave empty to auto-detect the first managed account.
IBKR_ACCOUNT=
# Safety: true blocks all order placement. Set to false only when you intend to trade.
IBKR_READONLY=true
# Market data type: 1=live, 2=frozen, 3=delayed, 4=delayed-frozen
IBKR_MARKET_DATA_TYPE=3

# --- Platform server --------------------------------------------------------
OBB_IBKR_HOST=127.0.0.1
OBB_IBKR_PORT=6900

# --- Security ----------------------------------------------------------------
# Shared secret required (as the "X-API-Key" header) to call /ibkr/* and
# /analytics/*. Empty = no auth (fine for local-only use, but a startup
# warning is printed every time). Generate one with: openssl rand -hex 32
OBB_IBKR_API_KEY=
# Comma-separated browser origins allowed to call the API cross-origin.
# Empty by default (no built-in web UI ships with this platform). Add your
# dashboard's origin here if you build one, e.g. http://localhost:3000
OBB_IBKR_CORS_ORIGINS=
# Append-only JSON-lines audit log of every order attempt (blocked or
# submitted). Resolved relative to the current working directory.
OBB_IBKR_AUDIT_LOG=logs/orders_audit.jsonl

# --- OpenBB provider API keys (optional) ------------------------------------
# yfinance works with no key. Add keys to unlock other providers, e.g.:
# OPENBB_FMP_API_KEY=...
# OPENBB_INTRINIO_API_KEY=...
# OPENBB_TIINGO_TOKEN=...
